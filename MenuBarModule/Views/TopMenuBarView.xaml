<UserControl x:Class="TasksManager.MenuBarModule.Views.TopMenuBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="800" MinHeight="100">
    <UserControl.Resources>
        <Style TargetType="Button"
               x:Key="BtnStyle"
               BasedOn="{StaticResource btnGradientBackground}">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius"
                            Value="5" />
                    <Setter Property="Width"
                            Value="60" />
                    <Setter Property="Height"
                            Value="60" />
                    <Setter Property="Margin"
                            Value="10,10,0,5" />
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="StackPanel"
               x:Key="BtnStackPanelStyle">
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
            <Setter Property="VerticalAlignment"
                    Value="Stretch" />
            <Setter Property="Orientation"
                    Value="Vertical" />
        </Style>
        <Style TargetType="TextBlock"
               x:Key="BtnTextBlockText">
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="FontSize"
                    Value="10" />
        </Style>
        <Style TargetType="Image"
               x:Key="ImageStyle">
            <Setter Property="MaxWidth"
                    Value="40" />
            <Setter Property="MaxHeight"
                    Value="40" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <Menu DockPanel.Dock="Top"
                  Background="{StaticResource MenuBarBackgroundBrush}">
                <MenuItem Header="{DynamicResource menuFile}">
                    <MenuItem Header="{DynamicResource menuFileOpen}" />
                    <MenuItem Header="{DynamicResource menuFileClose}" />
                    <MenuItem Header="{DynamicResource menuFileSave}" />
                </MenuItem>
                <MenuItem Header="{DynamicResource tasks}">
                    <MenuItem Header="{DynamicResource taskCreate}"
                              Command="{Binding CreateTaskCommand}"
                              CommandParameter="{DynamicResource taskCreateDialogTitle}" />
                </MenuItem>
                <MenuItem Header="{DynamicResource navBarCategories}">
                    <MenuItem Header="{DynamicResource categoryCreate}"
                              Command="{Binding CreateCategoryCommand}" 
                              CommandParameter="{DynamicResource categoryCreateDialogTitle}"/>
                </MenuItem>
            </Menu>
        </DockPanel>
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal">
            <StackPanel.Background>
                <StaticResource ResourceKey="MenuBarGradientBrush" />
            </StackPanel.Background>
            <Button Style="{StaticResource BtnStyle}">
                <Button.Content>
                    <StackPanel Style="{StaticResource BtnStackPanelStyle}">
                        <Image Source="/TasksManager.MenuBarModule;component/Resources/task_icon.png"
                               Style="{StaticResource ImageStyle}" />
                        <TextBlock Text="{DynamicResource navBarCategories}" 
                                   Style="{StaticResource BtnTextBlockText}"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Style="{StaticResource BtnStyle}">
                <Button.Content>
                    <StackPanel Style="{StaticResource BtnStackPanelStyle}">
                        <Image Source="/TasksManager.MenuBarModule;component/Resources/email_icon.png"
                               Style="{StaticResource ImageStyle}" />
                        <TextBlock Text="{DynamicResource navBarEmails}"
                                   Style="{StaticResource BtnTextBlockText}" />
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Style="{StaticResource BtnStyle}">
                <Button.Content>
                    <StackPanel Style="{StaticResource BtnStackPanelStyle}">
                        <Image Source="/TasksManager.MenuBarModule;component/Resources/category_icon.png"
                               Style="{StaticResource ImageStyle}" />
                        <TextBlock Text="{DynamicResource navBarProjects}"
                                   Style="{StaticResource BtnTextBlockText}" />
                    </StackPanel>
                </Button.Content>
            </Button>

            <!--<Separator />-->
        </StackPanel>
    </Grid>
</UserControl>
