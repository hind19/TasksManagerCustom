<UserControl x:Class="TasksManager.Application.Dialogs.TasksDialogs.AddUpdateTaskDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="540"
             MinWidth="480" MinHeight="460">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"    />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Task name -->
        <Grid Grid.Row="0" Margin="8,8,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*"    />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Style="{StaticResource dialogFieldLabelStyle}"
                       Text="{DynamicResource taskNameLabel}"
                       VerticalAlignment="Top" />
            <TextBox Grid.Column="1"
                     Text="{Binding CurrentTask.TaskName, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="80"
                     AcceptsReturn="False"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </Grid>

        <!-- Tab control -->
        <TabControl Grid.Row="1" Margin="8,0,8,4">

            <!-- Main tab -->
            <TabItem Header="{DynamicResource mainTabHeader}">
                <Grid Margin="4,6,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="108" />
                        <ColumnDefinition Width="*"   />
                        <ColumnDefinition Width="26"  />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6"    />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Projects -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{DynamicResource project}"
                               VerticalAlignment="Center" Margin="4,0" />
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding ProjectsList}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedProject}"
                              Margin="2" />
                    <Button Grid.Row="0" Grid.Column="2"
                            Content="×" Style="{StaticResource taskClearButtonStyle}"
                            Command="{Binding ClearProjectCommand}" />

                    <!-- Categories -->
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="{DynamicResource category}"
                               VerticalAlignment="Center" Margin="4,0" />
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding CategoriesList}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedCategory}"
                              Margin="2" />
                    <Button Grid.Row="1" Grid.Column="2"
                            Content="×" Style="{StaticResource taskClearButtonStyle}"
                            Command="{Binding ClearCategoryCommand}" />

                    <!-- Date -->
                    <Button Grid.Row="2" Grid.Column="0"
                            Content="{DynamicResource taskDateBtn}"
                            Style="{StaticResource taskActionButtonStyle}"
                            Command="{Binding OpenDateCommand}" />
                    <Grid Grid.Row="2" Grid.Column="1" Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"    />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*"    />
                        </Grid.ColumnDefinitions>
                        <xctk:DateTimePicker Grid.Column="0"
                                             Value="{Binding CurrentTask.StartDate}"
                                             Format="Custom" FormatString="dd.MM.yyyy HH:mm" />
                        <TextBlock Grid.Column="1"
                                   Text="—"
                                   VerticalAlignment="Center"
                                   Margin="4,0" />
                        <xctk:DateTimePicker Grid.Column="2"
                                             Value="{Binding CurrentTask.EndDate}"
                                             Format="Custom" FormatString="dd.MM.yyyy HH:mm" />
                    </Grid>
                    <Button Grid.Row="2" Grid.Column="2"
                            Content="×" Style="{StaticResource taskClearButtonStyle}"
                            Command="{Binding ClearDateCommand}" />

                    <!-- Remind me -->
                    <Button Grid.Row="3" Grid.Column="0"
                            Content="{DynamicResource taskReminderBtn}"
                            Style="{StaticResource taskActionButtonStyle}"
                            Command="{Binding OpenReminderCommand}" />
                    <TextBox Grid.Row="3" Grid.Column="1"
                             IsReadOnly="True" Margin="2" />
                    <Button Grid.Row="3" Grid.Column="2"
                            Content="×" Style="{StaticResource taskClearButtonStyle}"
                            Command="{Binding ClearReminderCommand}" />

                    <!-- Repeat -->
                    <Button Grid.Row="4" Grid.Column="0"
                            Content="{DynamicResource taskRepeatBtn}"
                            Style="{StaticResource taskActionButtonStyle}"
                            Command="{Binding OpenRepeatCommand}" />
                    <TextBox Grid.Row="4" Grid.Column="1"
                             Text="{Binding RepeatDisplayText, Mode=OneWay}"
                             IsReadOnly="True" Margin="2" />
                    <Button Grid.Row="4" Grid.Column="2"
                            Content="×" Style="{StaticResource taskClearButtonStyle}"
                            Command="{Binding ClearRepeatCommand}" />

                    <!-- Separator -->
                    <Separator Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" />

                    <!-- Priority -->
                    <TextBlock Grid.Row="6" Grid.Column="0"
                               Text="{DynamicResource priority}"
                               VerticalAlignment="Center" Margin="4,0" />
                    <ComboBox Grid.Row="6" Grid.Column="1"
                              ItemsSource="{Binding PrioritiesList}"
                              DisplayMemberPath="Name"
                              SelectedItem="{Binding CurrentTask.Priority}"
                              Margin="2" />
                    <Button Grid.Row="6" Grid.Column="2"
                            Content="×" Style="{StaticResource taskClearButtonStyle}"
                            Command="{Binding ClearPriorityCommand}" />

                    <!-- Status + % completion -->
                    <TextBlock Grid.Row="7" Grid.Column="0"
                               Text="{DynamicResource status}"
                               VerticalAlignment="Center" Margin="4,0" />
                    <StackPanel Grid.Row="7" Grid.Column="1"
                                Orientation="Horizontal" Margin="2">
                        <ComboBox ItemsSource="{Binding StatusesList}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedStatus}"
                                  MinWidth="130" />
                        <TextBlock Text="{DynamicResource taskPercentLabel}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,4,0" />
                        <xctk:IntegerUpDown Value="{Binding CurrentTask.PercentageOfCompletion}"
                                            Minimum="0" Maximum="100"
                                            Width="62" />
                    </StackPanel>
                    <Button Grid.Row="7" Grid.Column="2"
                            Content="×" Style="{StaticResource taskClearButtonStyle}"
                            Command="{Binding ClearStatusCommand}" />
                </Grid>
            </TabItem>

            <!-- Comment tab -->
            <TabItem Header="{DynamicResource taskCommentTabHeader}">
                <TextBox Text="{Binding CurrentTask.Comment, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Padding="4" />
            </TabItem>

        </TabControl>

        <!-- OK / Cancel -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="8,0,8,8">
            <Button Content="{DynamicResource okBtn}"
                    Style="{StaticResource dialogButtonStyle}"
                    Command="{Binding SaveCommand}" />
            <Button Content="{DynamicResource cancelBtn}"
                    Style="{StaticResource dialogButtonStyle}"
                    Command="{Binding CancelCommand}" />
        </StackPanel>

    </Grid>
</UserControl>
