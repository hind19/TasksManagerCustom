<UserControl x:Class="TasksManager.TasksScheduleModule.Views.MeasuresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:local="clr-namespace:TasksManager.TasksScheduleModule.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Stretch"
                    Grid.Row="0">
        </StackPanel>
        <DataGrid Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserSortColumns="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  GridLinesVisibility="All"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Visible"
                  HorizontalAlignment="Stretch"
                  Background="Aqua">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding MeasuresName}"
                                    MinWidth="100"/>
                <DataGridTextColumn Header="1"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="1"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="2"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="3"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="4"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="5"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="6"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="7"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="8"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="9"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="10"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="11"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="12"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="13"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="14"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="15"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="16"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="17"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="18"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="19"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="20"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="21"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="22"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="23"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="24"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="25"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="26"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="27"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="28"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="29"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="30"
                                    Binding="{Binding MeasuresValue}" />
                <DataGridTextColumn Header="31"
                                    Binding="{Binding MeasuresValue}" />
            </DataGrid.Columns>


        </DataGrid>
        <StackPanel Orientation="Horizontal"
                    Grid.Row="2">
            <ScottPlot:WpfPlot x:Name="WpfPlot1" />
        </StackPanel>


    </Grid>
</UserControl>
